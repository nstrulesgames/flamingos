# Supabase: Connect -> Session pooler. Keep credentials on the server only.
# Prefer a dedicated login with membership in the flamingo_app database role.
DATABASE_URL=
DATABASE_BACKEND=postgres
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# Google sign-in through Supabase Auth (no Google client secret belongs here).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_APP_URL=http://127.0.0.1:3000
GOOGLE_AUTH_ENABLED=false
